{
  "name": "@cfb/webgl",
  "version": "0.1.0",
  "description": "Library-first WebGL/R3F components and shaders for CFB Fantasy.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "ladle serve",
    "demo": "ladle serve",
    "demo:build": "ladle build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "three": "^0.179.0",
    "@react-three/fiber": ">=9",
    "@react-three/drei": ">=10"
  },
  "devDependencies": {
    "@ladle/react": "^5.4.0",
    "@react-three/drei": "^10.6.1",
    "@react-three/fiber": "^9.3.0",
    "three": "^0.179.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
